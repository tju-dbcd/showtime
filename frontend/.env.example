# 前端环境变量模板
# 复制为 .env.development / .env.production 并按需填写；真实值由 CI/部署流程注入，禁止提交进仓库。

# API 基础地址。
# 留空 = 开发时走 vite proxy（见 vite.config.ts），或生产同域部署（nginx 把静态文件与 /api 反代放在同一域名）。
# 非空 = 跨域直连后端，例如 VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# 开发代理目标（vite dev server 将 /api 转发到该地址）。
# 留空 = 默认指向生产后端（现状，见 CONVENTIONS.md）；本地全栈联调可设为
# VITE_DEV_PROXY_TARGET=http://localhost:5146（本地改、勿提交）。
# 注意：E2E 测试使用 page.route 全量 mock /api，不依赖此配置。
VITE_DEV_PROXY_TARGET=

