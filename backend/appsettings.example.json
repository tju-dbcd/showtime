{
  // 配置模板：复制为 appsettings.Production.json（或直接用环境变量覆盖），
  // 所有占位符 <...> 都必须在部署时替换为真实值，禁止把真实连接串/密钥提交进仓库。
  "ConnectionStrings": {
    // 完整 Oracle 连接串，格式参考：User Id=<用户名>;Password=<密码>;Data Source=<host>:1521/XEPDB1
    // 本地开发：dotnet user-secrets set "ConnectionStrings:Oracle" "User Id=...;Password=...;Data Source=..."
    // 生产部署：环境变量 ConnectionStrings__Oracle（或 KMS/Docker secret）
    "Oracle": "User Id=<your_user>;Password=<your_password>;Data Source=<host>:1521/XEPDB1",
    // Redis 连接串：本地开发用仓库根 docker-compose.yml 一键起（docker compose up -d redis）。
    // abortConnect=false 保证 Redis 未启动时应用照常启动、选座锁守卫自动降级为纯 Oracle 流程。
    // 生产部署：环境变量 ConnectionStrings__Redis（或其他密钥管理机制）
    "Redis": "localhost:6379,abortConnect=false,connectRetry=3,connectTimeout=3000"
  },
  "Redis": {
    // 选座锁 Redis 前置判定开关（kill-switch）：false 时完全走纯 Oracle 流程，无需发版即可回滚
    "SeatLockGuardEnabled": true,
    // Redis 锁 key 的 TTL（秒），必须与后端 SeatLockService 锁期（10 分钟）保持一致
    "SeatLockTtlSeconds": 600
  },
  // 阿里云 OSS 文件存储（演出海报/营销图/用户头像等图片资源）
  "Oss": {
    // kill-switch：false 时上传接口返回"未配置"错误；无 OSS 环境开发可置 false 先继续其他功能
    "Enabled": true,
    // Endpoint 必须与 Bucket 同 Region（如华北2 cn-hangzhou）
    "Endpoint": "https://oss-cn-hangzhou.aliyuncs.com",
    // 敏感项：不写进 appsettings，用环境变量 Oss__AccessKeyId / Oss__AccessKeySecret（或 KMS/Docker secret）注入
    // 本地开发：dotnet user-secrets set "Oss:AccessKeyId" "<ram-access-key-id>"
    // 本地开发：dotnet user-secrets set "Oss:AccessKeySecret" "<ram-access-key-secret>"
    "AccessKeyId": "<replace-with-ram-access-key-id>",
    "AccessKeySecret": "<replace-with-ram-access-key-secret>",
    // Bucket 全局唯一，建议含项目名；读写权限为公共读（Public Read）
    "Bucket": "showtime-assets",
    // 公开读访问基地址 = Bucket 外网访问域名
    "BaseUrl": "https://showtime-assets.oss-cn-hangzhou.aliyuncs.com",
    // 单文件大小上限（字节），默认 5MB
    "MaxFileSizeBytes": 5242880,
    // 扩展名白名单（禁止 .html/.svg/.js 等可执行/脚本类型）
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".gif" ]
  },
  "Jwt": {
    "Issuer": "ShowtimeBackend",
    "Audience": "ShowtimeFrontend",
    "ExpirationMinutes": 120,
    // 签名密钥，必须 >= 32 字节且为随机值；生产环境用环境变量 Jwt__Key 覆盖
    "Key": "<replace-with-a-random-key-at-least-32-bytes>"
  },
  "TicketSecurity": {
    // 电子票二维码 HMAC 密钥：Base64 编码，解码后至少 32 个随机字节
    // 生产部署推荐用环境变量 TicketSecurity__SigningKeyBase64 注入
    "SigningKeyBase64": "<replace-with-base64-encoded-random-bytes>"
  },
  "TicketRedemption": {
    // 电子票核销时间窗，合法范围均为 0..10080 分钟
    "OpenBeforeMinutes": 120,
    "CloseAfterMinutes": 120
  },
  "Exchange": {
    // 管理员审核时限、批准后的支付时限（分钟），以及超时扫描周期/批量大小
    "ReviewExpireMinutes": 30,
    "PaymentExpireMinutes": 15,
    "ExpirationScanIntervalSeconds": 30,
    "ExpirationBatchSize": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
