{
  "Jwt": {
    "Issuer": "ShowtimeBackend",
    "Audience": "ShowtimeFrontend",
    "ExpirationMinutes": 120
  },
  "TicketRedemption": {
    "OpenBeforeMinutes": 120,
    "CloseAfterMinutes": 120
  },
  "Exchange": {
    "ReviewExpireMinutes": 30,
    "PaymentExpireMinutes": 15,
    "ExpirationScanIntervalSeconds": 30,
    "ExpirationBatchSize": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
