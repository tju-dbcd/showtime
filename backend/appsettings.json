{
  "Jwt": {
    "Issuer": "ShowtimeBackend",
    "Audience": "ShowtimeFrontend",
    "ExpirationMinutes": 120
  },
  // 基础配置节（所有环境共享；具体环境可用 appsettings.{Environment}.json 或环境变量覆盖）：
  // Redis 连接串（ConnectionStrings:Redis）本地内置于 appsettings.Development.json，
  // 生产必须显式注入（ConnectionStrings__Redis），缺失时非开发环境启动即报错。
  "Redis": {
    // 选座锁 Redis 前置判定开关（kill-switch）：false 时完全走纯 Oracle 流程
    "SeatLockGuardEnabled": true,
    // 锁期唯一来源（秒）：DB 锁座表 EXPIRE_TIME 与 Redis 锁 key TTL 均取自此值，
    // 修改锁期只需改这里，无需再同步任何代码常量
    "SeatLockTtlSeconds": 600
  },
  // 本地磁盘文件存储（开发/联调中间态）：多实例共享挂载同一目录即可互通；
  // 默认关闭（生产用 OSS），本地开发在 appsettings.Development.json 开启
  "LocalStorage": {
    "Enabled": false,
    // 相对后端内容根目录（backend/）或绝对路径
    "RootDirectory": "showtime-files",
    // 公开访问基地址，默认由后端静态文件中间件按 /files 托管
    "BaseUrl": "/files"
  },
  "TicketRedemption": {
    "OpenBeforeMinutes": 120,
    "CloseAfterMinutes": 120
  },
  "Exchange": {
    "ReviewExpireMinutes": 30,
    "PaymentExpireMinutes": 15,
    "ExpirationScanIntervalSeconds": 30,
    "ExpirationBatchSize": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
