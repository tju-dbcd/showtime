{
  "Jwt": {
    // DEV-ONLY 本地开发密钥：仅用于 Development 环境，生产环境必须用环境变量 Jwt__Key 覆盖，切勿复用此值
    "Key": "mkC33VnUcNdKr1kSJAVJC8pr6ycnCh4WuFrxlR0G4UQ46ht5s7fghRpce4VEKHhl"
  },
  // 数据库连接串（ConnectionStrings:Oracle）不在仓库中配置，本地开发通过 dotnet user-secrets 注入：
  //   dotnet user-secrets set "ConnectionStrings:Oracle" "User Id=<姓名全拼>;Password=<密码>;Data Source=<host>:1521/XEPDB1"
  // 电子票签名密钥也通过 user-secrets 注入，值应为至少 32 个随机字节的 Base64 编码：
  //   dotnet user-secrets set "TicketSecurity:SigningKeyBase64" "<Base64密钥>"
  // 生产环境通过环境变量 ConnectionStrings__Oracle（或 KMS/Docker secret）注入，参见 appsettings.example.json。
  "ConnectionStrings": {
    // Redis 连接串：本地用 docker compose up -d redis 一键起；abortConnect=false 保证 Redis 未启动时后端照常启动
    "Redis": "localhost:6379,abortConnect=false,connectRetry=3,connectTimeout=3000"
  },
  "Redis": {
    // 选座锁 Redis 前置判定开关（kill-switch）：false 时完全走纯 Oracle 流程
    "SeatLockGuardEnabled": true,
    // Redis 锁 key TTL（秒），与后端 SeatLockService 锁期（10 分钟）保持一致
    "SeatLockTtlSeconds": 600
  },
  // 阿里云 OSS 文件存储：本地开发默认关闭（kill-switch），无需 OSS 即可启动/跑单测。
  // 联调 OSS 时置 Enabled=true 并填写 Endpoint/Bucket/BaseUrl，AccessKey 用 user-secrets 注入：
  //   dotnet user-secrets set "Oss:AccessKeyId" "<ram-access-key-id>"
  //   dotnet user-secrets set "Oss:AccessKeySecret" "<ram-access-key-secret>"
  "Oss": {
    "Enabled": false,
    "Endpoint": "https://oss-cn-hangzhou.aliyuncs.com",
    "Bucket": "showtime-assets",
    "BaseUrl": "https://showtime-assets.oss-cn-hangzhou.aliyuncs.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    "TicketSecurity": {
     "SigningKeyBase64": "dGVzdC1zaWduaW5nLWtleS1mb3ItZGV2ZWxvcG1lbnQtMTIzNA=="
   }
}
